<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="PYTHONPATH" value="H:\root\home\stmgroup-001\www\stmTest1" />
		<add key="WSGI_HANDLER" value="saytaman.wsgi.application" />
		<add key="DJANGO_SETTINGS_MODULE" value="saytaman.settings" />
		<add key="WSGI_LOG" value="H:\root\home\stmgroup-001\www\stmTest1\wsgi.log" />
	</appSettings>
	<system.webServer>
		<handlers>
			<add name="Python FastCGI" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\Python311\python.exe|C:\Python311\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
		</handlers>
		<httpErrors errorMode="Detailed" />
	</system.webServer>
	<system.web>
		<customErrors mode="Off"/>
	</system.web>
</configuration>